<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Replace __HOME__ and __REPO__; see docs/service.md -->
<plist version="1.0">
<dict>
  <key>Label</key>              <string>com.voiceinbox.service</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__REPO__/scripts/run.sh</string>
  </array>
  <key>RunAtLoad</key>          <true/>
  <key>KeepAlive</key>          <true/>
  <key>StandardOutPath</key>    <string>__HOME__/.local/share/voice-inbox/service.log</string>
  <key>StandardErrorPath</key>  <string>__HOME__/.local/share/voice-inbox/service.log</string>
</dict>
</plist>
